# CrowdShield — environment template
#
# Copy the sections you need. The API and each client read different files:
#   backend/.env          the API (never committed)
#   apps/web/.env         Vite  — variables must be prefixed VITE_
#   apps/mobile/.env      Expo  — variables must be prefixed EXPO_PUBLIC_
#
# Anything prefixed VITE_ or EXPO_PUBLIC_ is embedded in the client bundle and is
# therefore PUBLIC. Never put a secret behind those prefixes — the Google Maps and
# LLM credentials live server-side, configured through the authority settings page.

# ------------------------------------------------------------------ #
# backend/.env — the API
# ------------------------------------------------------------------ #
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/crowdshield
# Where the web client is served from, for CORS and cookie scope.
CLIENT_URL=http://localhost:5173

# Generate real values, e.g. `openssl rand -hex 48`. Two separate secrets so a
# leaked access secret cannot be used to mint refresh tokens.
JWT_ACCESS_SECRET=replace-me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace-me-differently
JWT_REFRESH_EXPIRES=7d

# Seeded by scripts/seedAdmin.js on first run.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me
ADMIN_MOBILE=9000000000

# ------------------------------------------------------------------ #
# apps/web/.env — the authority console
# ------------------------------------------------------------------ #
VITE_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------ #
# apps/mobile/.env — the Android citizen app
# ------------------------------------------------------------------ #

# Where the API lives. Leave unset during development: the app falls back to the
# host serving the Metro bundle (so a physical device on the same Wi-Fi works with
# no config), then to 10.0.2.2 for the Android emulator. Set it explicitly for a
# real device pointing at a deployed backend.
# EXPO_PUBLIC_API_URL=https://api.your-deployment.example/api
# EXPO_PUBLIC_API_PORT=5000

# Google Maps key for the Android base map. react-native-maps uses Google Maps on
# Android and there is no keyless alternative, so WITHOUT this the map renders
# without tiles — the app says so explicitly rather than showing a blank grid.
# Your position, the coverage boundary, density and routes still draw.
# EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# GitHub repository the in-app updater checks, as `owner/repo`. It reads
# /releases/latest, compares the tag against the installed version, and installs
# the attached .apk. Leave unset to disable update checking entirely.
# Only works for APK builds installed outside the Play Store — Play policy
# forbids an app updating itself.
# EXPO_PUBLIC_UPDATE_REPO=your-org/crowdshield
