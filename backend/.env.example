# Copy to .env for local development. In production (Render) these are set as
# service environment variables instead — see render.yaml.

NODE_ENV=development

# The host supplies PORT in production (Render). Locally this is the fallback.
PORT=5000

# MongoDB connection string, including the database name.
#   Local:      mongodb://127.0.0.1:27017/crowd_help
#   Production: a MongoDB Atlas URI, e.g.
#               mongodb+srv://USER:PASS@cluster.abc.mongodb.net/crowd_help
MONGO_URI=mongodb://127.0.0.1:27017/crowd_help

# Browser CORS origin for the web console. The mobile app does NOT need this
# (it isn't a browser). In production set it to the deployed web origin.
CLIENT_URL=http://localhost:5173

# Auth token signing. Use long, random, DIFFERENT strings in production.
# On Render these are generated automatically (generateValue).
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES=7d

# Seed admin — only used by `npm run seed:admin`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
ADMIN_MOBILE=0000000000
